# Copy to .env.local for local dev; set the same vars in Vercel for deploys.
# Real values NEVER go in this file or anywhere else in git.

# Resend — sending access is enough
RESEND_API_KEY=re_xxxxxxxxxxxx

# The leads spreadsheet (the long id in its URL)
LEADS_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google service account with Editor access to that Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=leads-writer@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON key file, \n escapes and all, in quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Where contact-form notifications go
NOTIFY_EMAIL=brooks@erasefriction.com

# Used to fetch the PDF for the email attachment (defaults to production)
NEXT_PUBLIC_SITE_URL=https://erasefriction.com
